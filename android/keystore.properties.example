# Copiá este archivo a android/keystore.properties (NO versionado, ver android/.gitignore) y completá
# con los datos reales de tu keystore de firma. Nunca subas ese archivo ni el .jks/.keystore al repo.
#
# storeFile: ruta al .jks/.keystore, relativa a android/app/ (ej. ../../release.keystore) o absoluta.
# storePassword / keyPassword: contraseñas elegidas al crear el keystore con keytool.
# keyAlias: el alias elegido al crear el keystore.
#
# Ver docs/ANDROID_PLAY_STORE.md para el comando exacto de keytool y el resto del flujo de publicación.

storeFile=
storePassword=
keyAlias=
keyPassword=
