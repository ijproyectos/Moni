# Variables públicas del frontend Vite (no son secretos de servidor)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Si tu proyecto usa una clave anon legacy, ajustar la integración explícitamente.
# Nunca colocar service_role, secretos OAuth ni claves privadas en variables VITE_*.

# --- Mercado Pago (Moni Plus) ---------------------------------------------------------------------------------
# Estos NO son variables de Vite ni van en este archivo con valores reales. Son SECRETS de Supabase Edge Functions
# (plus-subscription y mp-webhook). Se cargan con:
#   supabase secrets set MP_ACCESS_TOKEN=... MP_WEBHOOK_SECRET=... APP_URL=...
# Nunca los prefijes con VITE_: todo lo que empieza con VITE_ se publica en el navegador.
# MP_ACCESS_TOKEN=<access token de la aplicación de Mercado Pago>
# MP_WEBHOOK_SECRET=<clave secreta de firma del webhook (panel de Mercado Pago > Webhooks)>
# APP_URL=<origen público de la app, https obligatorio; http://localhost:5173 solo en desarrollo>

# --- Mercado Pago: importación automática de gastos (Moni Plus) ----------------------------------------------------
# Tampoco son variables de Vite: son SECRETS de Edge Functions (mp-oauth, mp-oauth-callback, mp-sync, mp-connect-webhook).
# Solo nombres; los valores se cargan con `supabase secrets set NOMBRE=...` y nunca se commitean. Detalle: docs/MERCADOPAGO.md.
# MP_CLIENT_ID=<id de la aplicación OAuth de Mercado Pago>
# MP_CLIENT_SECRET=<secreto de la aplicación OAuth>
# MP_OAUTH_REDIRECT_URI=<https://TU_ORIGEN/mp/callback.html, registrada también en Mercado Pago>
# MP_TOKEN_KEYS=<JSON {"kid": "base64 de 32 bytes aleatorios"}>
# MP_TOKEN_KEY_CURRENT=<kid con el que se cifran los tokens nuevos>
# MP_SYNC_CRON_SECRET=<mismo valor que usa el cron (Vault o private.app_secrets)>
# MP_CONNECT_WEBHOOK_SECRET=<clave HMAC del webhook de desvinculación>
# MP_CONNECT_WEBHOOK_ENABLED=<true solo cuando se capturó el manifiesto de la firma; por defecto apagado>
# ANTHROPIC_API_KEY=<ya existe para el asistente; se reutiliza>
# ALLOWED_ORIGINS=<debe incluir el origen de Moni, p. ej. https://moni.example.com,http://localhost:5173>
