# Variables públicas del frontend Vite (no son secretos de servidor)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Si tu proyecto usa una clave anon legacy, ajustar la integración explícitamente.
# Nunca colocar service_role, secretos OAuth ni claves privadas en variables VITE_*.
